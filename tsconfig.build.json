{
  // Configuração usada só no build de produção ("npm run build").
  // Ela compila apenas src/ e joga o JavaScript final em dist/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["tests/**/*.ts"]
}
