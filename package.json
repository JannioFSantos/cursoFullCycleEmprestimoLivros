{
  "name": "curso-full-cycle-emprestimo-livros",
  "version": "1.0.0",
  "private": true,
  "description": "API de emprestimos de biblioteca - Projeto B (nivel simples) do curso Full Cycle",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:openapi": "spectral lint docs/openapi.yaml --ruleset .spectral.yaml",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:volume": "tsx prisma/seed-volume.ts",
    "db:studio": "prisma studio",
    "k6:smoke": "k6 run k6/smoke.js",
    "k6:load": "k6 run k6/load.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.8",
    "prisma": "6.19.3",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stoplight/spectral-cli": "^6.17.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "globals": "^15.14.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
