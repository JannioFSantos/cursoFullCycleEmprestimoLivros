# -----------------------------------------------------------------------------
# Copie este arquivo para .env e ajuste se precisar:
#
#   cp .env.example .env      (Linux/macOS)
#   copy .env.example .env    (Windows)
#
# O .env NÃO é versionado. Este .env.example é o contrato de configuração.
# Em produção (Coolify) essas variáveis são cadastradas na aba "Environment".
# -----------------------------------------------------------------------------

# development | test | production
# (NODE_ENV continua aceito para quem já tinha o ambiente antigo configurado.)
APP_ENV=development

# Porta HTTP da API. No Coolify mantenha 3000.
PORT=3000

# 0.0.0.0 permite acesso de fora do container (obrigatório em Docker/Coolify).
HOST=0.0.0.0

# fatal | error | warning | warn | info | debug | trace
LOG_LEVEL=info

# Banco de dados local do docker-compose (serviço "db").
# Em produção, use a URL INTERNA do PostgreSQL criado no Coolify.
# Pode colar no formato antigo (postgresql://...): a aplicação troca o driver
# para psycopg 3 sozinha.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/biblioteca

# Usada para assinar o cookie de sessão da tela de demonstração.
# Em produção, gere um valor aleatório e guarde como secret no Coolify.
SECRET_KEY=troque-esta-chave-em-producao

# Banco usado pelos testes de integração (precisa existir).
# Se não definir, o padrão é o mesmo host/usuário com o banco biblioteca_test.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/biblioteca_test

# Regras de negócio configuráveis
PRAZO_DIAS=14
LIMITE_EMPRESTIMOS=3
