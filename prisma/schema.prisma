// Prisma schema — define as tabelas do PostgreSQL.
// Documentação: https://pris.ly/d/prisma-schema
//
// Decisões visíveis aqui:
//  - nomes de tabela/coluna em snake_case (@map) seguindo convenção SQL;
//  - ids UUID em vez de inteiro sequencial (não expõem volume e são seguros);
//  - índices compostos que sustentam as consultas do dia a dia;
//  - "exemplares_disponiveis" NÃO existe de propósito (ver ADR 0001).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusEmprestimo {
  ATIVO
  DEVOLVIDO

  @@map("status_emprestimo")
}

model Livro {
  id              String    @id @default(uuid()) @db.Uuid
  titulo          String
  autor           String
  isbn            String    @unique
  exemplaresTotal Int       @map("exemplares_total")
  criadoEm        DateTime  @default(now()) @map("criado_em")
  /// Preenchido quando o livro sai do catálogo, mas tem empréstimos antigos.
  excluidoEm      DateTime? @map("excluido_em")

  emprestimos Emprestimo[]

  @@map("livros")
}

model Usuario {
  id         String    @id @default(uuid()) @db.Uuid
  nome       String
  email      String    @unique
  criadoEm   DateTime  @default(now()) @map("criado_em")
  /// Preenchido quando o usuário sai da lista, mas tem empréstimos antigos.
  excluidoEm DateTime? @map("excluido_em")

  emprestimos Emprestimo[]

  @@map("usuarios")
}

model Emprestimo {
  id             String           @id @default(uuid()) @db.Uuid
  livroId        String           @map("livro_id") @db.Uuid
  usuarioId      String           @map("usuario_id") @db.Uuid
  status         StatusEmprestimo @default(ATIVO)
  dataEmprestimo DateTime         @map("data_emprestimo")
  /// Data limite de devolução, normalizada para 00:00 UTC.
  dataPrevista   DateTime         @map("data_prevista")
  dataDevolucao  DateTime?        @map("data_devolucao")

  livro   Livro   @relation(fields: [livroId], references: [id], onDelete: Restrict)
  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  // Índices que cobrem as consultas:
  //  - contar empréstimos ativos de um livro (disponibilidade)
  //  - contar empréstimos ativos de um usuário (limite de 3)
  //  - listar atrasados (status + data_prevista)
  @@index([livroId, status])
  @@index([usuarioId, status])
  @@index([status, dataPrevista])
  @@map("emprestimos")
}
